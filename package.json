{
  "name": "smallest-agent-nuxt-nitro-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 5900",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --maxWorkers=1",
    "generate:lesson": "node scripts/generate-lesson.mjs",
    "build": "npm run generate:lesson && nuxt build && node scripts/package-sdk.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs"
  },
  "dependencies": {
    "nuxt": "4.6.4",
    "nitropack": "2.13.6",
    "h3": "1.15.11",
    "vue": "3.5.45",
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14",
    "vitest": "5.1.0",
    "vite": "8.3.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.0.0",
    "@playwright/test": "1.65.0"
  }
}
